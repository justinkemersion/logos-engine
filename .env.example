# Optional branding (defaults derive from package.json name)
NEXT_PUBLIC_APP_NAME=Logos Engine
NEXT_PUBLIC_APP_TAGLINE=Read the Greek world from the source.

# Auth — set AUTH_SECRET and at least one provider pair
# Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Flux / PostgREST — see docs/LOGOS_WORKFLOW.md
FLUX_URL=
FLUX_GATEWAY_JWT_SECRET=
# FLUX_POSTGREST_SCHEMA: do not set here (use .env.local from pnpm flux:schema:sync)
FLUX_TLS_INSECURE=0

# Cursor SDK — optional; required only for `pnpm agent:passage` or server-action generation
# CURSOR_API_KEY=

# CLI Flux JWT sub for agent:passage:import (optional)
# LOGOS_FLUX_SUB=logos-cli-operator

# Enable Reading Desk draft button after reviewing persisted ai_runs drafts
# LOGOS_PASSAGE_DRAFT_UI_ENABLED=1

# Optional: also persist decomposed granular ai_runs rows
# LOGOS_PASSAGE_AGENT_DECOMPOSE=1
